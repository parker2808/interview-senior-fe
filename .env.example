# Local / Vercel env examples (do not commit real secrets)

# 6-digit PIN for Interview Q&A unlock (falls back to EDIT_PASSCODE if unset)
INTERVIEW_PASSCODE=123456

# Existing study-plan edit PIN (also unlocks Interview Q&A if INTERVIEW_PASSCODE is unset)
EDIT_PASSCODE=123456

# If both are set to different values, one PIN will not unlock both surfaces.
# Unlock sessions are HttpOnly cookies (12h) set by POST /api/auth/interview and
# POST /api/auth/edit. GET /api/auth/session reports valid scopes.

