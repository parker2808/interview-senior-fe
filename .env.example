# Local / Vercel env examples (do not commit real secrets)

# Interview Q&A PIN — 6 digits. Intentionally different from EDIT_PASSCODE.
# If unset, the existing interviewAuth helper falls back to EDIT_PASSCODE.
INTERVIEW_PASSCODE=123456

# Study-plan edit PIN — 6 digits. Intentionally different from INTERVIEW_PASSCODE.
# Does not unlock Interview Q&A when INTERVIEW_PASSCODE is also set.
EDIT_PASSCODE=654321

# If both are set to different values, one PIN will not unlock both surfaces.
# Unlock sessions are HttpOnly cookies (12h) set by POST /api/auth/interview and
# POST /api/auth/edit. GET /api/auth/session reports valid scopes.

# Private content repo (parker2808/interview-fe-data), pulled at build time
# Fine-grained PAT with Contents: Read only. Required on Vercel Production + Preview.
CONTENT_REPO_TOKEN=
# Optional. Defaults to main.
CONTENT_REPO_REF=main
# Local checkout or `npm run data:export` output. Skips the GitHub download.
CONTENT_LOCAL_PATH=
