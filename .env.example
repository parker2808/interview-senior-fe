# Local / Vercel env examples (do not commit real secrets)

# Sealed session cookie (32+ characters). Required in production.
# openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-32-plus-character-secret

# GitHub OAuth App credentials. Callback URL must be {origin}/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Env owners (login AND id must match when ids are set). Cannot be removed in the UI.
AUTH_OWNER_GITHUB_LOGINS=parker2808
AUTH_OWNER_GITHUB_IDS=38419968

# Optional fallback viewer list (backward compat). Empty = no env viewers.
# Prefer adding people in /admin/access so ids are stored and sessions can be revoked.
AUTH_ALLOWED_GITHUB_LOGINS=
AUTH_ALLOWED_GITHUB_IDS=

# Upstash Redis REST (Vercel Marketplace → Storage → Upstash).
# Either pair works. Without these, env owners still sign in; member/share writes are disabled.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local screenshots / UI only (ignored in production builds)
# AUTH_DEV_MOCK=owner

# Private content repo (parker2808/interview-fe-data), pulled at build time
# Fine-grained PAT with Contents: Read only. Required on Vercel Production + Preview.
CONTENT_REPO_TOKEN=
# Optional. Defaults to main.
CONTENT_REPO_REF=main
# Local checkout or `npm run data:export` output. Skips the GitHub download.
CONTENT_LOCAL_PATH=
